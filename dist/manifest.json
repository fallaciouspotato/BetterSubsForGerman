{
  "manifest_version": 3,
  "name": "Dual Sub - Language Learning",
  "version": "0.1.0",
  "description": "Learn German by watching YouTube with adaptive dual subtitles, click-to-lookup, quizzes, and progressive word masking.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/main-world.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "js": [
        "src/content/bridge.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Dual Sub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
